# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.mr-consulting.fr
# Adresse affichée et destinataire des demandes
NEXT_PUBLIC_CONTACT_EMAIL=contact@mr-consulting.fr
# Lien de prise de rendez-vous (optionnel, ex. Calendly / Cal.com)
NEXT_PUBLIC_BOOKING_URL=
# Domaine déclaré dans Plausible Analytics (optionnel ; vide = pas d'analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Envoi des e-mails du formulaire via Resend (https://resend.com)
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. "MR Consulting <site@mr-consulting.fr>"
CONTACT_FROM=
# Destinataire des notifications (par défaut : NEXT_PUBLIC_CONTACT_EMAIL)
CONTACT_TO=
